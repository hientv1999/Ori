# Ori — LVGL desktop simulator (screenshot renderer)
#
# Builds with the MinGW gcc / g++ that ships with CodeBlocks. No CMake,
# no SDL2, no extra installs. Output:
#   build/ori_sim.exe             the renderer binary
#   screenshots/*.bmp             one BMP per Ori screen
#
# Usage:
#   mingw32-make           build only
#   mingw32-make run       build + render
#   mingw32-make clean     wipe build/ and screenshots/

CXX        := g++
CC         := gcc
MKDIR      := mkdir -p
RM         := rm -rf

# Source roots (relative to sim/).
FW_INC      := ../firmware/include
FW_SRC      := ../firmware/src
LVGL_ROOT   := ../firmware/.pio/libdeps/ori/lvgl
LVGL_SRC    := $(LVGL_ROOT)/src

# Path overrides — Windows shells sometimes hand `find` a Windows-style path.
# Using bash's find via mingw32-make handles forward slashes fine.

# All LVGL C sources, recursive.
LVGL_C_SRCS := $(shell find $(LVGL_SRC) -name '*.c')

# Ori-branded extended Montserrat fonts. Pure C, generated by lv_font_conv.
FW_C_SRCS := $(wildcard $(FW_SRC)/fonts/*.c)

# Firmware sources that are LVGL-pure (no Arduino headers inside).
FW_CPP_SRCS := \
  $(FW_SRC)/theme.cpp \
  $(FW_SRC)/mock_data.cpp \
  $(FW_SRC)/ui_helpers.cpp \
  $(wildcard $(FW_SRC)/widgets/*.cpp) \
  $(wildcard $(FW_SRC)/screens/*.cpp)

# Sim-local sources.
SIM_CPP_SRCS := main.cpp arduino_shim.cpp

# Build dir mirrors source tree so multiple files with same basename don't
# collide (e.g. there are many lv_*.c files; we just want unique paths).
BUILD := build

# Object files.
LVGL_OBJS   := $(LVGL_C_SRCS:%.c=$(BUILD)/%.o)
FW_C_OBJS   := $(FW_C_SRCS:%.c=$(BUILD)/%.o)
FW_OBJS     := $(FW_CPP_SRCS:%.cpp=$(BUILD)/%.o)
SIM_OBJS    := $(SIM_CPP_SRCS:%.cpp=$(BUILD)/%.o)
ALL_OBJS    := $(LVGL_OBJS) $(FW_C_OBJS) $(FW_OBJS) $(SIM_OBJS)

# Compiler flags.
CPPFLAGS := \
  -DLV_CONF_INCLUDE_SIMPLE \
  -DLV_LVGL_H_INCLUDE_SIMPLE \
  -DLV_MEM_SIZE=2097152 \
  -I. \
  -I$(FW_INC) \
  -I$(FW_SRC) \
  -I$(LVGL_ROOT) \
  -I$(LVGL_SRC)

CFLAGS   := -O2 -Wall -Wno-unused-function -Wno-unused-variable -Wno-format -std=gnu11
CXXFLAGS := -O2 -Wall -Wno-unused-function -Wno-unused-variable -Wno-format -std=gnu++14
LDFLAGS  :=

TARGET := $(BUILD)/ori_sim.exe

.PHONY: all run clean
all: $(TARGET)

$(TARGET): $(ALL_OBJS)
	@$(MKDIR) $(dir $@)
	$(CXX) $(LDFLAGS) -o $@ $^

# Pattern rule — C
$(BUILD)/%.o: %.c
	@$(MKDIR) $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c -o $@ $<

# Pattern rule — C++
$(BUILD)/%.o: %.cpp
	@$(MKDIR) $(dir $@)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c -o $@ $<

run: $(TARGET)
	@$(MKDIR) screenshots
	./$(TARGET)

clean:
	$(RM) $(BUILD) screenshots
